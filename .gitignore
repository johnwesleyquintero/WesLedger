__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.out
CMakeFiles/
CMakeCache.txt
cmake_install.manifest
Makefile
chartio_python_client.egg-info/

# Node specific (if applicable)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.flowconfig
.gitattributes
.eslintcache
.nyc_output
.coverage
.nyc_output/
coverage/
junit.xml
testem.log
testem.yml
